# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of the site, without a trailing slash. Used for the QR code,
# sitemap, canonical URLs and the password-reset e-mail link.
NEXT_PUBLIC_SITE_URL=https://kafeadi.com

# Never add SUPABASE_SERVICE_ROLE_KEY here: the app does not need it, and it
# must never reach the browser.
